            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('service is up', () => pm.response.to.have.status(200));",
              "pm.test('status is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Config service reachable",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/learning/whoami",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "learning",
            "whoami"
          ]
        },
        "description": "Returns the environment label. If it mentions config-service, the config server is genuinely being read (not the local fallback)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200', () => pm.response.to.have.status(200));",
              "const label = pm.response.text();",
              "console.log('Environment: ' + label);",
              "pm.test('label served by config-service', () => pm.expect(label).to.include('config-service'));"
            ]
          }
        }
      ]
    },
