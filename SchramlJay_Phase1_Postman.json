{
  "info": {
    "name": "LMS - learning-service (Phase 1)",
    "description": "Tests for learning-service (port 8105): the four endpoints from service.html, role scoping, the admin /courses CRUD cycle, and the 400/401/403/404/409 cases.\n\nRun the whole collection in order: request 15 stores the id of the next class and request 22 undoes the change, so it is safe to re-run.\n\nRoles are sent as X-User / X-Role headers (stand-in for Keycloak). Run headless: newman run SchramlJay_Phase1_Postman.json -r cli,htmlextra",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8105"
    },
    {
      "key": "courseId",
      "value": "ap-precalc"
    },
    {
      "key": "student",
      "value": "student1"
    },
    {
      "key": "teacher",
      "value": "janderson"
    },
    {
      "key": "otherTeacher",
      "value": "ppatel"
    },
    {
      "key": "admin",
      "value": "admin1"
    },
    {
      "key": "crudId",
      "value": "ap-demo-course"
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "percentBefore",
      "value": ""
    },
    {
      "key": "completedBefore",
      "value": ""
